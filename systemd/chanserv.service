# A systemd *user* unit (installs under ~/.config/systemd/user, run via
# `systemctl --user ...`) -- no root/sudo anywhere. `make install` rewrites
# the /usr/local/bin, /etc/sekurircd and /var/lib/sekurircd paths below to
# $(PREFIX)/$(SYSCONFDIR)/$(STATEDIR) -- see the Makefile's install target.
# Edit those by hand if installing this file directly.
[Unit]
Description=SekurIRCd ChanServ
After=network.target sekurircd.service

[Service]
Type=forking
WorkingDirectory=/var/lib/sekurircd/chanserv
PIDFile=/var/lib/sekurircd/chanserv/chanserv.pid
ExecStart=/usr/local/bin/chanserv --config /etc/sekurircd/services.toml --daemon --pidfile /var/lib/sekurircd/chanserv/chanserv.pid
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/sekurircd/chanserv

[Install]
WantedBy=default.target
